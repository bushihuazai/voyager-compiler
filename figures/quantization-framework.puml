@startuml quantization-framework
!theme plain
skinparam backgroundColor #FFFFFF

title Voyager Compiler - Quantization Framework

' Class diagram for quantization
abstract class QuantizationSpec {
  +dtype: str
  +qscheme: QScheme
  +observer_or_fake_quant_ctr: Callable
  +ch_axis: Optional[int]
  +is_dynamic: bool
  +scale_dtype: Optional[torch.dtype]
  +zero_point_dtype: Optional[torch.dtype]
  +quant_min: Optional[int]
  +quant_max: Optional[int]
  --
  +__post_init__(): void
}

class DerivedQuantizationSpec {
  +derive_qparams_fn: Callable
  +dtype: str
  +qscheme: QScheme
  --
  Derives params from other specs
}

class QConfig {
  +activation: Optional[QuantizationSpec]
  +weight: Optional[QuantizationSpec]
  +bias: Optional[QuantizationSpec]
  --
  Configuration for a layer
}

class QuantizationConfig {
  +input_activation: Optional[QuantizationSpec]
  +output_activation: Optional[QuantizationSpec]
  +weight: Optional[QuantizationSpec]
  +bias: Optional[QuantizationSpec]
  +is_qat: bool
  --
  Extended configuration
}

enum QScheme {
  PER_TENSOR_SYMMETRIC
  PER_CHANNEL_SYMMETRIC
  MICROSCALING
  GROUP_WISE_AFFINE
  --
  Quantization schemes
}

abstract class ObserverOrFakeQuantize {
  +dtype: torch.dtype
  +qscheme: QScheme
  --
  +forward(x: Tensor): Tensor
  +calculate_qparams(): Tuple
}

class Observer {
  +min_val: Tensor
  +max_val: Tensor
  +dtype: torch.dtype
  +qscheme: QScheme
  --
  +forward(x: Tensor): Tensor
  +calculate_qparams(): Tuple[Tensor, Tensor]
  +reset_min_max_vals(): void
}

class FakeQuantize {
  +fake_quant_enabled: Tensor
  +observer_enabled: Tensor
  +observer: Observer
  +quant_min: int
  +quant_max: int
  +dtype: torch.dtype
  +qscheme: QScheme
  --
  +forward(x: Tensor): Tensor
  +calculate_qparams(): Tuple[Tensor, Tensor]
  +enable_observer(enabled: bool): void
  +enable_fake_quant(enabled: bool): void
}

class FusedAmaxObsFakeQuantize {
  +observer: Observer
  +amax_reduce_dim: Optional[List[int]]
  +amax_keepdim: bool
  --
  +forward(x: Tensor): Tuple[Tensor, Tensor]
  Outputs both quantized value and amax
}

class XNNPACKQuantizer {
  +global_config: Optional[QuantizationConfig]
  +operator_type_config: Dict
  --
  +annotate(model: GraphModule): GraphModule
  +validate(model: GraphModule): void
  +set_global(config: QuantizationConfig): Self
  +set_module_type(type, config): Self
}

' Relationships
QuantizationSpec <|-- DerivedQuantizationSpec
QuantizationSpec --> QScheme : uses
QuantizationConfig --> QuantizationSpec : contains
QConfig --> QuantizationSpec : contains

ObserverOrFakeQuantize <|-- Observer
ObserverOrFakeQuantize <|-- FakeQuantize
ObserverOrFakeQuantize --> QScheme : uses
FakeQuantize *-- Observer : contains
FakeQuantize <|-- FusedAmaxObsFakeQuantize

XNNPACKQuantizer --> QuantizationConfig : uses
XNNPACKQuantizer ..> QConfig : creates

' Quantization workflow
package "Quantization Workflow" {
  usecase "1. Configure\nQuantization" as UC1
  usecase "2. Annotate\nModel Graph" as UC2
  usecase "3. Insert\nObservers/FQ" as UC3
  usecase "4. Calibration\n/Training" as UC4
  usecase "5. Calculate\nQParams" as UC5
  usecase "6. Convert to\nQuantized Ops" as UC6
}

actor User
User --> UC1
UC1 --> UC2
UC2 --> UC3
UC3 --> UC4
UC4 --> UC5
UC5 --> UC6

